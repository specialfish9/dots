[
  {
    "modules-center": [
      "clock",
      "network",
      "battery",
    ],
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-right": [
      "niri/language",
      "tray"
    ],
    "backlight": {
      "format": " {}%",
      "interval": 1,
      "justify": "center",
      "tooltip": true
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-alt": "{icon} {time}",
      "format-charging": " {capacity}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "format-plugged": " {capacity}%",
      "justify": "center",
      "states": {
        "critical": 15,
        "warning": 30
      }
    },
      // Language switcher
  "niri/language": {
    "format": " {}",
    "format-en": "US",
    "format-it": "IT"
  },
    "clock": {
      "calendar": {
        "format": {
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>"
        },
        "mode": "year",
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "on-scroll": 1,
        "weeks-pos": "right"
      },
      "format": "{:%H:%M %d %b}",
      "format-alt": "{:%H:%M}",
      "justify": "center",
      "tooltip": true,
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
      "format": "{icon} {0}%",
      "format-icons": [
        ""
      ],
      "interval": 15,
      "justify": "center"
    },
    "niri/workspaces": {
      "all-outputs": false,
      "format": "{index} {icon}",
      "format-icons": {
        "active": "",
        "default": "",
        "urgent": ""
      },
      "justify": "center",
      "on-click": "activate"
    },
    "layer": "top",
    "memory": {
      "format": " {}%",
      "interval": 30,
      "justify": "center"
    },
    "network": {
      "format-ethernet": "ETH",
      "format-icons": [
        ""
      ],
      "format-wifi": "{icon} {essid}",
      "justify": "center",
      "tooltip": true,
      "tooltip-format-wifi": "{essid}"
    },
    "position": "top",
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "default": [
          "",
          "",
          ""
        ]
      },
      "format-muted": "{icon} {volume}%",
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "scroll-step": 5,
      "tooltip": false
    },
    "temperature": {
      "critical-threshold": 80,
      "format": " {temperatureC}°C",
      "justify": "center",
      "thermal-zone": 0
    },
    "tray": {
      "icon-size": 18,
      "spacing": 10
    }
  }
]
