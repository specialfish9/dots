[global]
    monitor = 0
    follow = mouse
    width = (400, 600)
    height = 300
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 10
    
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    indicate_hidden = yes
    transparency = 5
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 8
    frame_width = 0
    separator_color = frame
    sort = yes
    
    font = BlexMono Nerd Font
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    enable_recursive = false
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/apps/
    
    sticky_history = yes
    history_length = 20
    
    dmenu = /usr/bin/wofi -p dunst:
    browser = /usr/bin/floorp
    
    always_run_script = true
    
    title = Dunst
    class = Dunst
    
    corner_radius = 8
    ignore_dbusclose = false
    
    force_xwayland = false
    force_xinerama = false
    
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    foreground = "#2d2d2d"
    background = "#ffffff"
    highlight = "#555555"
    frame_color = "#404040"
    timeout = 5
    icon = dialog-information

[urgency_normal]
    foreground = "#2d2d2d"
    background = "#ffffff"
    highlight = "#4a90e2"
    frame_color = "#404040"
    timeout = 10
    icon = dialog-information

[urgency_critical]
    background = "#962121"
    foreground = "#ffffff"
    highlight = "#e74c3c"
    frame_color = "#8b4242"
    timeout = 0
    icon = dialog-error

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period
