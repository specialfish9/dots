* {
	border: none;
  border-radius: 0;
  font-family: "FiraCode" ;
  font-weight: bold;
	font-size: 15px;
	min-height: 10px;
  padding-left: 3px;
  padding-right: 3px;
  padding-top: 10px;
  padding-bottom: 10px;
}

window#waybar {
	background: black;
}

window#waybar.hidden {
	opacity: 0.2;
}

#window {
	padding-left: 0px;
	padding-right: 0px;
	transition: none;
  color: transparent;
	background: transparent;
}

#workspaces {
  padding:0px;
  margin:0px;
	background: #161320;
}

#workspaces button {
  padding: 0px;
  margin:0px;
	transition: none;
	color: white;
	background: transparent;
	font-size: 16px;
}

#workspaces button.focused {
	color: #ABE9B3;
}

#workspaces button:hover {
	transition: none;
	box-shadow: inherit;
	text-shadow: inherit;
	color: #FAE3B0;
    border-color: #E8A2AF;
    color: #E8A2AF;
}

#workspaces button.focused:hover {
    color: #E8A2AF;
}

#network {
	transition: none;
	background: #161320;
	color: #FAE3B0;
}

#pulseaudio {
	transition: none;
	background: #161320;
  color: #bd93f9;
}

#battery {
	transition: none;
	color: #F8BD96;
	background: #161320;
}

#battery.charging, #battery.plugged {
	color: #161320;
    background-color: #B5E8E0;
}

#battery.critical:not(.charging) {
    background-color: #B5E8E0;
    color: #161320;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

@keyframes blink {
    to {
        background-color: #BF616A;
        color: #B5E8E0;
    }
}
	/*
* green:  color: #ABE9B3;
* red:    color: #EBa9B3;
	orange: color: #F8BD96;
	yellow color: #FAE3B0;
	azzurro: color: #B5E8E0;
   purple:color: #bd93f9;
* */

#backlight {
	transition: none;
	background: #161320;
	color: #DDB6F2;
}
#clock {
	transition: none;
	background: #161320;
	color: #EBa9B3;
	/*background: #1A1826;*/
}

#memory {
	transition: none;
	background: #161320;
	color: #96CDFB;
}

#temperature {
	background: #161320;
color: #B5E8E0;
}
#cpu {
  font-size: 12px;
	transition: none;
	background: #161320;
  color: #BFF6C3;
}

#tray {
	transition: none;
	color: #B5E8E0;
	background: #161320;
}

#custom-launcher {
	font-size: 24px;
	transition: none;
    color: #89DCEB;
    background: #161320;
}

#custom-power {
	font-size: 20px;
	transition: none;
	color: #161320;
	background: #F28FAD;
}

#custom-wallpaper {
	transition: none;
	color: #161320;
	background: #C9CBFF;
}

#custom-updates {
	transition: none;
	color: #161320;
	background: #E8A2AF;
}

